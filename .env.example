# Sumber data (lihat src/shared/data/dataService.js)
#   mock     (default) data buatan: semua kategori ISPU + data bolong, untuk mengembangkan dan menguji tampilan
#   dataset  rekaman Open-Meteo 1 Okt–1 Nov 2026, untuk demo, uji usability, dan screenshot laporan
VITE_DATA_SOURCE=mock

# Hanya untuk mode dataset: waktu yang dianggap "sekarang" (WIB), harus di dalam rekaman.
# Kosongkan untuk default (26 Okt 2026, 12.00 WIB = 7 hari sebelum akhir rekaman).
# VITE_DATASET_NOW=2026-10-26T12:00
